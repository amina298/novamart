{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
   "moduleResolution": "bundler",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "types": ["node", "express"],
    "typeRoots": ["./node_modules/@types", "./src/types"],

    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}